{
  "name": "QuoteRequest",
  "type": "object",
  "properties": {
    "customer_type": {
      "type": "string",
      "enum": [
        "Privatkunde",
        "Gesch\u00e4ftskunde",
        "Beh\u00f6rde",
        "Other"
      ]
    },
    "company": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "vat_number": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "Lagerung",
        "B\u00fcro",
        "Sanit\u00e4r",
        "Werkstatt",
        "K\u00fchlung",
        "Veranstaltung",
        "Unterkunft",
        "Industrie",
        "Sonstige"
      ]
    },
    "base_size": {
      "type": "string",
      "enum": [
        "10 ft",
        "20 ft",
        "40 ft",
        "Unsicher"
      ]
    },
    "base_type": {
      "type": "string",
      "enum": [
        "Standard",
        "High Cube",
        "Neu",
        "Gebraucht"
      ]
    },
    "modifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "delivery_postcode": {
      "type": "string"
    },
    "delivery_city": {
      "type": "string"
    },
    "delivery_country": {
      "type": "string",
      "default": "Deutschland"
    },
    "preferred_date": {
      "type": "string",
      "format": "date"
    },
    "crane_required": {
      "type": "boolean"
    },
    "ground_prepared": {
      "type": "boolean"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Neu",
        "In Bearbeitung",
        "Angebot gesendet",
        "Abgeschlossen"
      ],
      "default": "Neu"
    }
  },
  "required": [
    "name",
    "email",
    "purpose"
  ]
}