# Canonical public origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://nordikacontainer.com

# Optional in development; the production start script sets an absolute local path.
NORDIKA_SUBMISSIONS_DIR=.data/submissions

# Multi-tenant Supabase platform. Anon key is safe client-side; every query must filter by store_id.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_STORE_ID=your-store-id

# Dashboard/platform API host, server-side only. Used for checkout order submission.
ECOM_PLATFORM_API_URL=https://your-platform-host.example
